# Copy to deploy/.env on the VPS and fill in. Do NOT commit the real .env.
# POSTGRES_PASSWORD is interpolated unescaped into a postgresql:// URL below --
# use a URL-safe generator (e.g. `openssl rand -hex 32`), not one that can emit
# @ : / # % ? (those would break DATABASE_URL parsing).
POSTGRES_PASSWORD=change-me-long-random
OPENBRAIN_TOKEN=change-me-long-random
OPENBRAIN_HOST=brain.srv1608402.hstgr.cloud
# IANA timezone name search's date_from/date_to filters interpret "calendar day"
# in (defaults to UTC if unset) -- set to the deployment's actual timezone.
OPENBRAIN_TIMEZONE=Europe/Vienna
# DATABASE_URL is constructed inside compose from POSTGRES_PASSWORD; shown here for local test:
# DATABASE_URL=postgresql://openbrain:change-me-long-random@localhost:5432/openbrain

# openbrain-gui
OPENBRAIN_GUI_HOST=gui.yourhost.example.com
# Generate with: htpasswd -nB <username>   (then escape every literal $ as $$
# for docker-compose's env-var interpolation, e.g. $$apr1$$... not $apr1$...)
GUI_BASIC_AUTH_USERS=someuser:$$apr1$$examplehash

# --- stripe-mcp (docker-compose.stripe.yml) --------------------------------
# Stripe RESTRICTED key, READ scopes only. Start with rk_test_..., switch to
# rk_live_... after verifying in test mode. Exact scope list: stripe-mcp/DEPLOY.md
STRIPE_API_KEY=rk_test_xxx
# test | live -- informational (startup probe + /health). Real split is the key above.
STRIPE_MODE=test
# Bearer token Hermes sends to reach the MCP endpoint -- the only thing gating it
# on the shared Docker network. Generate URL-safe: openssl rand -hex 32
STRIPE_MCP_TOKEN=change-me-long-random
STRIPE_DEFAULT_CURRENCY=EUR
